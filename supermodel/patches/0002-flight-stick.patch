-  if (maxRange > 3000)
-    printf("Detected %s\n", joyDetails->axisName[axisNum]);
-  else
-  {
-    cancelled = true;
-    puts("Not Detected");
-  }
-  goto Finish;
-
-Cancelled:
-  puts("[Cancelled]");
-  cancelled = true;
-
-Finish:
-  if (escape)
-    escape->Release();
-  if (confirm)
-    confirm->Release();
-  if (output)
-    output->Release();
-  return !cancelled;
-}
