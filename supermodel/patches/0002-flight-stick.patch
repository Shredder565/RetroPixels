-bool CInputSystem::EqualsIgnoreCase(const string& str1, const char *str2)
-{
-  for (string::const_iterator ci = str1.begin(); ci < str1.end(); ++ci)
-  {
-    if (*str2 == '\0' || tolower(*ci) != tolower(*str2))
-      return false;
-    str2++;
-  }
-  return *str2 == '\0';
-}
