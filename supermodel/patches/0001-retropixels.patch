-static std::string GetFileBaseName(const std::string &file)
-{
-  std::string base = file;
-  size_t pos = file.find_last_of('/');
-  if (pos != std::string::npos)
-    base = file.substr(pos + 1);
-  pos = file.find_last_of('\\');
-  if (pos != std::string::npos)
-    base = file.substr(pos + 1);
-  return base;
-}
