-    SetLogger(oldLogger);
-  }
-#endif // SUPERMODEL_DEBUGGER
-
-  // Save NVRAM
-  SaveNVRAM(Model3);
-
-  // Close audio
-  CloseAudio();
-
-  // Shut down renderers
-  delete Render2D;
-  delete Render3D;
-  delete superAA;
-
-  return 0;
-
-  // Quit with an error
-QuitError:
