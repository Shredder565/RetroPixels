diff --git a/pixelu/wii/Externals/libusb/CMakeLists.txt b/pixelu/wii/Externals/libusb/CMakeLists.txt
index 9d70e9d..e7d4fd3 100644
--- a/pixelu/wii/Externals/libusb/CMakeLists.txt
+++ b/pixelu/wii/Externals/libusb/CMakeLists.txt
@@ -1,18 +1,32 @@
 # libusb (LGPL-2.1-or-later): USB passthrough, the GameCube adapter and real
-# Bluetooth adapters. Built from its Windows sources (WinUSB and UsbDK backends)
-# with the config.h libusb ships for MSVC in libusb/msvc.
+# Bluetooth adapters. On Windows built from its Windows sources (WinUSB and UsbDK
+# backends) with the config.h libusb ships for MSVC in libusb/msvc; on Linux from
+# its usbfs backend with netlink hot-plug (no libudev) and PixelU-Wii's
+# linux/config.h.
 set(src "${THIRD}/libusb/libusb")
 
 add_library(usb STATIC EXCLUDE_FROM_ALL)
 pixelu_add_sources(usb
   IN "${src}/libusb" core.c descriptor.c hotplug.c io.c strerror.c sync.c
-  IN "${src}/libusb/os" events_windows.c threads_windows.c windows_common.c windows_usbdk.c windows_winusb.c
 )
+if(WIN32)
+  pixelu_add_sources(usb
+    IN "${src}/libusb/os" events_windows.c threads_windows.c windows_common.c windows_usbdk.c windows_winusb.c
+  )
+  set(usb_config "${src}/msvc")
+else()
+  pixelu_add_sources(usb
+    IN "${src}/libusb/os" events_posix.c threads_posix.c linux_usbfs.c linux_netlink.c
+  )
+  set(usb_config "${CMAKE_CURRENT_SOURCE_DIR}/linux")
+  find_package(Threads REQUIRED)
+  target_link_libraries(usb PRIVATE Threads::Threads)
+endif()
 set_target_properties(usb PROPERTIES VERSION 1.0.26)
 # BEFORE: other libraries have a config.h too; libusb's must win.
 target_include_directories(usb BEFORE
   PUBLIC "${src}/libusb"
-  PRIVATE "${src}/msvc"
+  PRIVATE "${usb_config}"
 )
 pixelu_third_party_target(usb)
 
diff --git a/pixelu/wii/Externals/libusb/linux/config.h b/pixelu/wii/Externals/libusb/linux/config.h
new file mode 100644
index 0000000..84effc1
--- /dev/null
+++ b/pixelu/wii/Externals/libusb/linux/config.h
@@ -0,0 +1,31 @@
+/* Original code for RetroPixels (PixelU-Wii). Not derived from Dolphin.
+ *
+ * libusb's config.h for the Linux build (the part libusb's configure script
+ * would write): glibc 2.35+ on x86-64, the usbfs backend with netlink hot-plug
+ * events (no libudev). Only what libusb's core, the POSIX event/thread code and
+ * the Linux backend test for is defined. */
+#ifndef PIXELU_LIBUSB_LINUX_CONFIG_H
+#define PIXELU_LIBUSB_LINUX_CONFIG_H
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE 1
+#endif
+
+#define DEFAULT_VISIBILITY __attribute__((visibility("default")))
+#define PRINTF_FORMAT(a, b) __attribute__((__format__(__printf__, a, b)))
+#define ENABLE_LOGGING 1
+
+#define PLATFORM_POSIX 1
+#define HAVE_OS_TIMER 1
+#define HAVE_TIMERFD 1
+#define HAVE_EVENTFD 1
+#define HAVE_PIPE2 1
+#define HAVE_NFDS_T 1
+#define HAVE_CLOCK_GETTIME 1
+#define HAVE_PTHREAD_CONDATTR_SETCLOCK 1
+#define HAVE_PTHREAD_SETNAME_NP 1
+#define HAVE_SYS_TIME_H 1
+#define HAVE_ASM_TYPES_H 1
+#define HAVE_SYSLOG 1
+
+#endif
